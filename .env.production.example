# Variables à renseigner sur l’hébergeur (Vercel, Docker, etc.) — environnement « Production ».
# Remplacez l’URL ci-dessous par le lien public HTTPS de votre API (suffixe /api si votre backend l’utilise).

# Lien du backend de production (visible par le navigateur)
NEXT_PUBLIC_API_URL=https://VOTRE-BACKEND-PROD.example.com/api

# Uniquement si vous utilisez le proxy Next (NEXT_PUBLIC_API_URL=/api) :
# API_URL=https://VOTRE-BACKEND-PROD.example.com/api
