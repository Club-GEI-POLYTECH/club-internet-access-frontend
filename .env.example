# =============================================================================
# Club Internet Access — Frontend (variables d’environnement)
# Copiez ce fichier :  cp .env.example .env.local   puis ajustez les valeurs.
# =============================================================================

# --- Développement local (défaut) ---
# Backend sur la machine (voir next.config.js : rewrite /api → ce host)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Cible du proxy Next pour /api/* (sans suffixe :path* — ajouté automatiquement).
API_URL=http://localhost:4000/api

# =============================================================================
# PRODUCTION — remplacez par l’URL réelle de votre backend (HTTPS recommandé)
# =============================================================================
#
# Option A — Appels directs navigateur → backend (CORS autorisé côté API) :
#   NEXT_PUBLIC_API_URL=https://VOTRE-BACKEND-PROD.example.com/api
#   (API_URL peut rester celle du local pour le dev ; en prod définissez-la
#    seulement si vous utilisez le proxy, voir option B.)
#
# Option B — Même origine : le front appelle /api, Next proxy vers le backend :
#   NEXT_PUBLIC_API_URL=/api
#   API_URL=https://VOTRE-BACKEND-PROD.example.com/api
#
# Compatibilité ancien nom (optionnel) :
# VITE_API_URL=
